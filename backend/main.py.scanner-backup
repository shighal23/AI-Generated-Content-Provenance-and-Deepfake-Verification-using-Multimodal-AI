# =========================================================
# SECURE UPLOAD HELPERS
# =========================================================

def create_safe_upload_path(
    original_filename: str
) -> Path:

    original_name = Path(
        original_filename
    ).name

    extension = Path(
        original_name
    ).suffix.lower()

    safe_filename = (
        f"{uuid.uuid4().hex}{extension}"
    )

    return UPLOAD_DIR / safe_filename


# =========================================================
# SHA-256 FILE HASH
# =========================================================

def calculate_sha256(
    file_path: Path
) -> str:

    sha256 = hashlib.sha256()

    with open(
        file_path,
        "rb"
    ) as file:

        for chunk in iter(
            lambda: file.read(8192),
            b""
        ):

            sha256.update(
                chunk
            )

    return sha256.hexdigest()


