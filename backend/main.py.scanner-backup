@app.post("/api/file-integrity/verify")
async def verify_file_integrity(
    file: UploadFile = File(...)
):

    if not file.filename:

        raise HTTPException(
            status_code=400,
            detail="No file selected."
        )

    file_data = await file.read()

    if not file_data:

        raise HTTPException(
            status_code=400,
            detail="Uploaded file is empty."
        )

    if len(
        file_data
    ) > MAX_FILE_SIZE:

        raise HTTPException(
            status_code=400,
            detail=(
                "File size must be less than 10 MB."
            )
        )

    file_path = create_safe_upload_path(
        file.filename
    )

    try:

        file_path.write_bytes(
            file_data
        )

    except Exception as exc:

        raise HTTPException(
            status_code=500,
            detail=(
                f"Unable to save file: {str(exc)}"
            )
        )

    try:

        sha256_hash = calculate_sha256(
            file_path
        )

    except Exception as exc:

        raise HTTPException(
            status_code=500,
            detail=(
                "SHA-256 calculation failed: "
                f"{str(exc)}"
            )
        )

    extension = Path(
        file.filename
    ).suffix.lower()

    file_type = (
        extension.replace(
            ".",
            ""
        ).upper()
        if extension
        else "UNKNOWN"
    )

    # -----------------------------------------------------
    # BUILD REPORT
    # -----------------------------------------------------

    report = {

        "filename": file.filename,

        "file_type": file_type,

        "file_size_bytes": len(
            file_data
        ),

