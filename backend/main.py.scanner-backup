# =========================================================
# SAVE HISTORY
# =========================================================

def save_history(
    history
):

    HISTORY_FILE.write_text(
        json.dumps(
            history,
            indent=4,
            ensure_ascii=False
        ),
        encoding="utf-8"
    )


# =========================================================
# GENERATE NEXT HISTORY ID
# =========================================================

def get_next_history_id(
    history
):

    if not history:

        return 1

    valid_ids = []

    for item in history:

        try:

            valid_ids.append(
                int(
                    item.get(
                        "id",
                        0
                    )
                )
            )

        except (
            TypeError,
            ValueError
        ):

            continue

    if not valid_ids:

        return 1

    return max(
        valid_ids
    ) + 1


