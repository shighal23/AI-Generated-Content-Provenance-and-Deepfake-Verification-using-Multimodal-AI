    history = load_history()

    selected_record = None

    for item in history:

        try:

            item_id = int(
                item.get(
                    "id"
                )
            )

        except (
            TypeError,
            ValueError
        ):

            continue

        if item_id == history_id:

            selected_record = item

            break

    # -----------------------------------------------------
    # CHECK HISTORY RECORD
    # -----------------------------------------------------

    if selected_record is None:

        raise HTTPException(
            status_code=404,
            detail="History record not found."
        )

