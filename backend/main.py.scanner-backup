# =========================================================
# REPORT TEXT CLEANING
# =========================================================

def clean_report_text(
    value
):

    if value is None:

        return "N/A"

    text = str(
        value
    )

    # Replace common Unicode symbols
    # with PDF-safe ASCII equivalents.
    text = text.replace(
        "→",
        "->"
    )

    text = text.replace(
        "✓",
        "[OK]"
    )

    text = text.replace(
        "✗",
        "[X]"
    )

    text = text.replace(
        "⚠",
        "[WARNING]"
    )

    # Escape XML/HTML special characters
    # used by ReportLab Paragraph.
    text = escape(
        text
    )

    # Helvetica-based ReportLab styles may not
    # support arbitrary Unicode characters.
    # Replace unsupported characters safely.
    text = text.encode(
        "latin-1",
        "replace"
    ).decode(
        "latin-1"
    )

    return text


# =========================================================
# ADD REPORT VALUE
# =========================================================

def add_report_value(
    story,
    key,
    value,
    styles,
    level=0
):

    indent = (
        "&nbsp;" *
        (
            level * 4
        )
    )

    # -----------------------------------------------------
    # DICTIONARY
    # -----------------------------------------------------

    if isinstance(
        value,
        dict
    ):

        story.append(
            Paragraph(
                (
                    f"{indent}"
                    f"<b>"
                    f"{clean_report_text(key)}"
                    f"</b>"
                ),
                styles[
                    "ReportHeading"
                ]
            )
        )

        for child_key, child_value in value.items():

            add_report_value(
                story,
                child_key,
                child_value,
                styles,
                level + 1
            )

        return

    # -----------------------------------------------------
    # LIST
    # -----------------------------------------------------

    if isinstance(
        value,
        list
    ):

        story.append(
            Paragraph(
                (
                    f"{indent}"
                    f"<b>"
                    f"{clean_report_text(key)}"
                    f"</b>"
                ),
                styles[
                    "ReportHeading"
                ]
            )
        )

        if not value:

            story.append(
                Paragraph(
                    (
                        f"{indent}"
                        f"None"
                    ),
                    styles[
                        "ReportBody"
                    ]
                )
            )

        else:

            for item in value:

                if isinstance(
                    item,
                    (
                        dict,
                        list
                    )
                ):

                    add_report_value(
                        story,
                        "Item",
                        item,
                        styles,
                        level + 1
                    )

                else:

                    story.append(
                        Paragraph(
                            (
                                f"{indent}"
                                f"- "
                                f"{clean_report_text(item)}"
                            ),
                            styles[
                                "ReportBody"
                            ]
                        )
                    )

        return

    # -----------------------------------------------------
    # SIMPLE VALUE
    # -----------------------------------------------------

    story.append(
        Paragraph(
            (
                f"{indent}"
                f"<b>"
                f"{clean_report_text(key)}:"
                f"</b> "
                f"{clean_report_text(value)}"
            ),
            styles[
                "ReportBody"
            ]
        )
    )


