        "file_type": "file-integrity",

        "risk_score": 0,

        "verdict": "HASH_GENERATED",

        "report": {

            "verification": {

                "filename": file.filename,

                "file_size_bytes": len(
                    file_data
                ),

                "file_type": (
                    "file-integrity"
                ),

                "status": "completed"
            },

            "file_integrity": report
